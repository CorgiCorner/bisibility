generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  owner
  admin
  member
  auditor
  viewer
}

enum Device {
  desktop
  mobile
}

enum LocationKind {
  country
  region
  city
}

enum RankCheckFrequency {
  paused
  manual
  daily
  weekly
  monthly
  custom_cron
}

enum ProviderKind {
  serp
  analytics
  enrichment
}

enum ProviderStatus {
  connected
  needs_reauth
  ready
  planned
  optional
}

enum SearchInsightsPropertyStatus {
  active
  archived
}

enum ProviderAllocationUnit {
  cents
  units
}

enum ProviderCostFeature {
  backlinks
  domain_overview
  keyword_metrics
  keyword_research
  rank_check
  ranked_keywords
}

enum AlertConditionType {
  threshold
  change_pct
  ctr_drop
  position_drop
  downtrend
  enters_top_n
  exits_top_n
  competitor_overtake
  serp_feature
  url_mismatch
}

enum AlertSeverity {
  info
  warning
  urgent
}

enum AlertTargetType {
  keyword
  tag
  all
}

enum AlertChannel {
  email
  slack
  webhook
}

enum TriggeredAlertStatus {
  firing
  resolved
  acknowledged
  muted
}

enum AlertDeliveryState {
  pending
  digest_pending
  digesting
  digested
  suppressed
  delivering
  delivered
  dead_letter
  skipped
}

enum NotificationType {
  alert_fired
  check_complete
  check_failed
  invite
  member_joined
  import_done
  import_failed
  system
}

enum MigrationScope {
  keywords
  full
}

enum CloudImportState {
  idle
  receiving
  importing
  done
  failed
}

enum ProjectWriteMode {
  active
  migration_hold
  migrated
}

enum ProjectMarketStatus {
  active
  paused
  removed
}

enum SignalSource {
  rank_tracker
  search_analytics
  url_inspection
  sitemap
  deploy
  cms
  search_engine_status
  manual
  api
}

enum SignalSeverity {
  info
  warning
  critical
}

enum OnboardingQuizStatus {
  IN_PROGRESS
  COMPLETED
  SKIPPED_ALL
}

model User {
  id                           String                   @id @default(cuid())
  publicId                     String                   @unique
  name                         String
  email                        String                   @unique
  emailVerified                Boolean                  @default(false)
  twoFactorEnabled             Boolean                  @default(false)
  image                        String?
  role                         Role                     @default(member)
  isInstanceAdmin              Boolean                  @default(false)
  deactivatedAt                DateTime?
  marketingEmailUnsubscribedAt DateTime?
  pausedSearchAnalyticsImports SearchAnalyticsImport[]  @relation("SearchImportPausedBy")
  sessions                     Session[]
  accounts                     Account[]
  twoFactors                   TwoFactor[]
  legacyOauthApplications      LegacyOauthApplication[]
  legacyOauthAccessTokens      LegacyOauthAccessToken[]
  legacyOauthConsents          LegacyOauthConsent[]
  oauthClients                 OauthClient[]
  oauthRefreshTokens           OauthRefreshToken[]
  oauthAccessTokens            OauthAccessToken[]
  oauthConsents                OauthConsent[]
  projects                     Project[]                @relation("ProjectOwner")
  memberships                  Membership[]
  auditLogs                    AuditLog[]               @relation("AuditActor")
  notifications                Notification[]
  notificationPreferences      NotificationPreference[]
  sentInvites                  Invite[]
  createdAlertRules            AlertRule[]
  alertRuleRecipients          AlertRuleRecipient[]
  savedViews                   SavedView[]
  slackConnections             SlackConnection[]
  createdMigrationTokens       MigrationToken[]
  personalAccessTokens         PersonalAccessToken[]
  writeModeChangedProjects     Project[]                @relation("ProjectWriteModeChangedBy")
  signalsCreated               Signal[]                 @relation("SignalCreator")
  createdIngestHooks           IngestHook[]
  onboardingQuizResponses      OnboardingQuizResponse[]
  createdAt                    DateTime                 @default(now())
  updatedAt                    DateTime                 @updatedAt

  @@map("users")
}

model Session {
  id                 String              @id @default(cuid())
  publicId           String              @unique
  token              String              @unique
  expiresAt          DateTime
  ipAddress          String?
  userAgent          String?
  userId             String
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  oauthRefreshTokens OauthRefreshToken[]
  oauthAccessTokens  OauthAccessToken[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  providerId            String
  accountId             String
  password              String?
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([providerId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verifications")
}

model TwoFactor {
  id                      String    @id @default(cuid())
  secret                  String
  backupCodes             String
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([userId])
  @@map("twoFactor")
}

model LegacyOauthApplication {
  id           String                   @id @default(cuid())
  name         String
  icon         String?
  metadata     String?
  clientId     String                   @unique
  clientSecret String?
  redirectUrls String
  type         String
  disabled     Boolean                  @default(false)
  userId       String?
  user         User?                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessTokens LegacyOauthAccessToken[]
  consents     LegacyOauthConsent[]
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  @@index([userId])
  @@map("oauthApplication")
}

model LegacyOauthAccessToken {
  id                    String                 @id @default(cuid())
  accessToken           String                 @unique
  refreshToken          String                 @unique
  accessTokenExpiresAt  DateTime
  refreshTokenExpiresAt DateTime
  clientId              String
  application           LegacyOauthApplication @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  userId                String?
  user                  User?                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  scopes                String
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([clientId])
  @@index([userId])
  @@map("oauthAccessToken")
}

model LegacyOauthConsent {
  id           String                 @id @default(cuid())
  clientId     String
  application  LegacyOauthApplication @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  userId       String
  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  scopes       String
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  consentGiven Boolean

  @@index([clientId])
  @@index([userId])
  @@map("oauthConsent")
}

model OauthClient {
  id                      String              @id @default(cuid())
  clientId                String              @unique
  clientSecret            String?
  disabled                Boolean?            @default(false)
  skipConsent             Boolean?
  enableEndSession        Boolean?
  subjectType             String?
  scopes                  String[]
  userId                  String?
  user                    User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt               DateTime?           @default(now())
  updatedAt               DateTime?           @updatedAt
  name                    String?
  uri                     String?
  icon                    String?
  contacts                String[]
  tos                     String?
  policy                  String?
  softwareId              String?
  softwareVersion         String?
  softwareStatement       String?
  redirectUris            String[]
  postLogoutRedirectUris  String[]
  tokenEndpointAuthMethod String?
  grantTypes              String[]
  responseTypes           String[]
  public                  Boolean?
  type                    String?
  requirePKCE             Boolean?
  referenceId             String?
  metadata                Json?
  refreshTokens           OauthRefreshToken[]
  accessTokens            OauthAccessToken[]
  consents                OauthConsent[]

  @@index([userId])
  @@map("oauthClient")
}

model OauthRefreshToken {
  id           String             @id @default(cuid())
  token        String             @unique
  clientId     String
  client       OauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  sessionId    String?
  session      Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId       String
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId  String?
  expiresAt    DateTime
  createdAt    DateTime           @default(now())
  revoked      DateTime?
  authTime     DateTime?
  scopes       String[]
  accessTokens OauthAccessToken[]

  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@map("oauthRefreshToken")
}

model OauthAccessToken {
  id           String             @id @default(cuid())
  token        String             @unique
  clientId     String
  client       OauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  sessionId    String?
  session      Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId       String?
  user         User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId  String?
  refreshId    String?
  refreshToken OauthRefreshToken? @relation(fields: [refreshId], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  createdAt    DateTime           @default(now())
  scopes       String[]

  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([refreshId])
  @@map("oauthAccessTokenV2")
}

model OauthConsent {
  id          String      @id @default(cuid())
  clientId    String
  client      OauthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  userId      String?
  user        User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId String?
  scopes      String[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([clientId])
  @@index([userId])
  @@map("oauthConsentV2")
}

model Jwks {
  id         String    @id @default(cuid())
  publicKey  String
  privateKey String
  createdAt  DateTime  @default(now())
  expiresAt  DateTime?

  @@map("jwks")
}

model Waitlist {
  id                    String    @id @default(cuid())
  email                 String    @unique
  source                String
  cloudPrice            String?
  prefersUsagePricing   Boolean   @default(false)
  hostedPrice           String?
  hostedPriceAnsweredAt DateTime?
  // Lifetime count: incremented on every accepted upsert across all sources;
  // not a per-source feedback counter and never reset.
  submissions           Int       @default(1)
  lastSubmittedAt       DateTime  @default(now())
  createdAt             DateTime  @default(now())

  @@map("waitlists")
}

model Project {
  id                               String                           @id @default(cuid())
  publicId                         String                           @unique
  name                             String
  // Optional: a workspace exists before the user says which domain to track.
  domain                           String?
  isSample                         Boolean                          @default(false)
  trackingScope                    String                           @default("country")
  writeMode                        ProjectWriteMode                 @default(active)
  writeModeChangedAt               DateTime?
  writeModeChangedById             String?
  writeModeChangedBy               User?                            @relation("ProjectWriteModeChangedBy", fields: [writeModeChangedById], references: [id], onDelete: SetNull)
  onboardingCompletedAt            DateTime?
  ownerId                          String
  owner                            User                             @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members                          Membership[]
  keywords                         Keyword[]
  markets                          ProjectMarket[]
  savedKeywords                    SavedKeyword[]
  tags                             Tag[]
  competitors                      Competitor[]
  defaults                         ProjectDefaults?
  providerConnections              ProviderConnection[]
  providerCostEntries              ProviderCostEntry[]
  queuedRankCheckBatches           QueuedRankCheckBatch[]
  backlinkSnapshots                BacklinkSnapshot[]
  domainOverviewSnapshots          DomainOverviewSnapshot[]
  pageTrafficSnapshots             PageTrafficSnapshot[]
  searchAnalyticsDaily             SearchAnalyticsDaily[]
  searchAnalyticsQueryDaily        SearchAnalyticsQueryDaily[]
  searchAnalyticsPageDaily         SearchAnalyticsPageDaily[]
  searchAnalyticsQueryPageDaily    SearchAnalyticsQueryPageDaily[]
  searchAnalyticsImports           SearchAnalyticsImport[]
  searchAnalyticsSyncPartitions    SearchAnalyticsSyncPartition[]
  searchAnalyticsRequestUsage      SearchAnalyticsRequestUsage[]
  searchInsightsPropertyRegistry   SearchInsightsPropertyRegistry[]
  organicSessionsDaily             OrganicSessionsDaily[]
  organicSessionsPageDaily         OrganicSessionsPageDaily[]
  apiKeys                          ApiKey[]
  ingestHooks                      IngestHook[]
  auditLogs                        AuditLog[]
  alertRules                       AlertRule[]
  signals                          Signal[]
  sitemapMonitoringEnabled         Boolean                          @default(true)
  budgetCapCents                   Int                              @default(5000)
  providerAllocationsInitializedAt DateTime?
  sitemapSnapshots                 SitemapSnapshot[]
  urlPresences                     UrlPresence[]
  webhookEndpoints                 WebhookEndpoint[]
  slackConnection                  SlackConnection?
  notifications                    Notification[]
  notificationPreferences          NotificationPreference[]
  savedViews                       SavedView[]
  invites                          Invite[]
  migrationTokens                  MigrationToken[]
  cloudImportJobs                  CloudImportJob[]
  createdAt                        DateTime                         @default(now())
  updatedAt                        DateTime                         @updatedAt

  @@index([ownerId])
  @@index([writeModeChangedById])
  @@map("projects")
}

model ProviderCostEntry {
  id                String              @id @default(cuid())
  projectId         String
  project           Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  connectionId      String
  feature           ProviderCostFeature @default(ranked_keywords)
  provider          String?
  keywordId         String?
  source            String?
  trigger           String?
  tag               String?
  correlationId     String?
  providerRequestId String?
  // A migration-only partial unique index covers non-null connection/request identifiers.
  usageQuantity     Decimal?            @db.Decimal(18, 6)
  costCents         Decimal             @db.Decimal(10, 4)
  unitCostCents     Decimal?            @db.Decimal(10, 4)
  cached            Boolean             @default(false)
  failed            Boolean             @default(false)
  createdAt         DateTime            @default(now())

  @@index([projectId, createdAt])
  @@index([connectionId, createdAt])
  @@index([connectionId, feature, createdAt])
  @@index([projectId, correlationId])
  @@index([provider, providerRequestId])
  @@map("provider_cost_entries")
}

model Membership {
  id        String   @id @default(cuid())
  publicId  String   @unique
  userId    String
  projectId String
  role      Role     @default(member)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, projectId])
  @@index([projectId])
  @@map("memberships")
}

model ProjectDefaults {
  id                     String             @id @default(cuid())
  projectId              String             @unique
  project                Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  locationKey            String?
  locationRef            Location?          @relation("ProjectDefaultLocation", fields: [locationKey], references: [canonicalKey], onDelete: Restrict)
  country                String?
  city                   String?
  device                 Device?
  serpDepth              Int                @default(100)
  serpStopOnMatch        Boolean            @default(true)
  frequency              RankCheckFrequency @default(daily)
  cronExpression         String?
  timezone               String             @default("UTC")
  jitterMinutes          Int                @default(60)
  inspectionDailyLimit   Int                @default(50)
  searchSyncImportMonths Int?
  searchSyncPace         String?
  lastCheckedAt          DateTime?
  nextCheckAt            DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@index([locationKey])
  @@map("project_defaults")
}

model ProjectMarket {
  id               String              @id @default(cuid())
  publicId         String              @unique
  projectId        String
  locationId       String
  status           ProjectMarketStatus @default(active)
  project          Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  location         Location            @relation(fields: [locationId], references: [id], onDelete: Restrict)
  alertRuleMarkets AlertRuleMarket[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@unique([projectId, locationId])
  @@index([projectId, status, createdAt, id])
  @@index([locationId])
  @@map("project_markets")
}

// Migration-only expression index: keywords_projectId_normalized_text_idx
// (20260727064500_keyword_match_index) uses lower(btrim(text)), which Prisma cannot model.
model Keyword {
  id                   String                   @id @default(cuid())
  publicId             String                   @unique
  projectId            String
  text                 String
  location             String
  locationId           String
  device               Device                   @default(desktop)
  targetUrl            String?
  topic                String?
  intent               String?
  project              Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  locationRef          Location                 @relation(fields: [locationId], references: [id], onDelete: Restrict)
  tags                 KeywordTag[]
  schedule             KeywordSchedule?
  dispatchState        KeywordDispatchState?
  queuedRankCheckTasks QueuedRankCheckTask[]
  rankChecks           RankCheck[]
  trafficSnapshots     KeywordTrafficSnapshot[]
  alertTargets         AlertRuleTarget[]
  triggeredAlerts      TriggeredAlert[]
  signals              Signal[]
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  @@unique([projectId, text, locationId, device])
  @@index([projectId])
  @@index([projectId, topic])
  @@index([locationId])
  @@map("keywords")
}

model SavedKeyword {
  id             String   @id @default(cuid())
  publicId       String   @unique
  projectId      String
  text           String
  normalizedText String
  location       String
  countryCode    String
  languageCode   String
  volume         Int?
  difficulty     Int?
  cpc            Float?
  intent         String?
  trend          Json?
  variantCount   Int      @default(0)
  sourceSeed     String?
  savedAt        DateTime @default(now())
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, normalizedText, location, countryCode, languageCode], map: "saved_keywords_market_pair_key")
  @@index([projectId, savedAt])
  @@map("saved_keywords")
}

model Location {
  id               String            @id @default(cuid())
  kind             LocationKind
  displayName      String
  countryCode      String
  regionCode       String?
  cityName         String?
  gl               String
  hl               String
  languageCode     String
  languageLabel    String
  primaryGeoCode   Int?
  primaryGeoName   String
  secondaryGeoName String
  canonicalKey     String            @unique
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  keywords         Keyword[]
  projectDefaults  ProjectDefaults[] @relation("ProjectDefaultLocation")
  projectMarkets   ProjectMarket[]

  @@index([countryCode])
  @@map("locations")
}

model Tag {
  id           String            @id @default(cuid())
  publicId     String            @unique
  projectId    String
  name         String
  color        String?
  project      Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  keywords     KeywordTag[]
  alertTargets AlertRuleTarget[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([projectId, name])
  @@index([projectId])
  @@map("tags")
}

model Competitor {
  id        String   @id @default(cuid())
  publicId  String   @unique
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  domain    String
  label     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, domain])
  @@index([projectId])
  @@map("competitors")
}

model KeywordTag {
  id        String   @id @default(cuid())
  keywordId String
  tagId     String
  keyword   Keyword  @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([keywordId, tagId])
  @@index([tagId])
  @@map("keyword_tags")
}

model KeywordSchedule {
  id             String             @id @default(cuid())
  keywordId      String             @unique
  keyword        Keyword            @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  frequency      RankCheckFrequency
  serpDepth      Int?
  cronExpression String?
  timezone       String
  jitterMinutes  Int                @default(60)
  lastCheckedAt  DateTime?
  nextCheckAt    DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@map("keyword_schedules")
}

model KeywordDispatchState {
  keywordId   String   @id
  keyword     Keyword  @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  nextCheckAt DateTime

  @@index([nextCheckAt, keywordId])
  @@map("keyword_dispatch_states")
}

model RankCheck {
  id                   String               @id @default(cuid())
  publicId             String               @unique
  keywordId            String
  keyword              Keyword              @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  position             Int?
  previousPosition     Int?
  rankingUrl           String?
  /// Allowed values: "running", "completed", "failed", "deferred".
  status               String               @default("completed")
  error                String?
  errorCode            String?
  checkedAt            DateTime             @default(now())
  provider             String
  /// Allowed values when set: "scheduled", "manual".
  trigger              String?
  scheduleId           String?
  workflowRunId        String?
  scheduledAt          DateTime?
  startedAt            DateTime?
  finishedAt           DateTime?
  deferredReason       String?
  requestedDepth       Int?
  normalizationVersion String?              @default("v1")
  costCents            Decimal?             @db.Decimal(10, 4)
  estimatedCostCents   Decimal?             @db.Decimal(10, 4)
  billingUnits         Int?
  /// Compact top-100 organic snapshot as [{ domain, position }]. Null means unavailable or legacy.
  organicRanks         Json?
  raw                  Json?
  attempts             Json?
  viaFallback          Boolean              @default(false)
  degradedToCountry    Boolean              @default(false)
  attemptCount         Int                  @default(1)
  triggeredAlerts      TriggeredAlert[]
  queuedTask           QueuedRankCheckTask?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@unique([keywordId, checkedAt])
  @@index([keywordId, checkedAt(sort: Desc), id(sort: Desc)])
  @@index([checkedAt])
  // Migration-only partial index: rank_checks (checkedAt, id) WHERE raw IS NOT NULL.
  @@index([scheduledAt])
  @@index([startedAt])
  @@index([status, checkedAt])
  @@index([viaFallback, checkedAt, id])
  @@index([provider, checkedAt, id])
  @@index([trigger, checkedAt, id])
  @@map("rank_checks")
}

model RankCheckRawPurgeProgress {
  id              String    @id
  cutoff          DateTime?
  retentionDays   Int?
  maxBatches      Int
  batchCount      Int       @default(0)
  updatedCount    Int       @default(0)
  completed       Boolean   @default(false)
  hasMore         Boolean   @default(false)
  resultClearedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Migration-only partial index: id WHERE completed AND resultClearedAt IS NULL.
  @@index([completed, resultClearedAt, id], map: "rank_check_raw_purge_progress_reclaim_idx")
  @@map("rank_check_raw_purge_progress")
}

model QueuedRankCheckBatch {
  id              String                @id
  projectId       String
  project         Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  connectionId    String?
  connection      ProviderConnection?   @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  provider        String                @default("dataforseo")
  priority        String
  state           String
  claimedAt       DateTime
  queueDeadlineAt DateTime
  submittedAt     DateTime?
  ambiguousAt     DateTime?
  terminalAt      DateTime?
  expiresAt       DateTime?
  error           String?
  tasks           QueuedRankCheckTask[]
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([projectId, createdAt])
  @@index([state, expiresAt])
  // Migration-only partial index: queued_rank_check_batches (queueDeadlineAt, id) for active states.
  @@map("queued_rank_check_batches")
}

model QueuedRankCheckTask {
  id                        String               @id
  batchId                   String
  batch                     QueuedRankCheckBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  keywordId                 String
  keyword                   Keyword              @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  rankCheckId               String               @unique
