// User-scoped bearer credential (bsb_pat_live_*) that acts as the user across all
// their project memberships, unlike project-scoped api_keys. Effective access
// per project is the intersection of the token scope tier and the membership
// role, computed at request time.
model PersonalAccessToken {
  id         String    @id @default(cuid())
  publicId   String    @unique
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  hashedKey  String    @unique
  prefix     String
  scopes     String[]  @default(["read"])
  expiresAt  DateTime?
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId])
  @@index([prefix])
  @@map("personal_access_tokens")
}

