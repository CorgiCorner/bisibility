// Composite same-project foreign keys and immutable-history triggers are owned by the additive SQL.
model LocalMonitor {
  id String @id @default(cuid())
  publicId String @unique
  projectId String
  name String
  state String @default("active")
  version Int @default(0)
  currentRevisionId String?
  currentScheduleIntentId String?
  createdAt DateTime @default(now())
  updatedAt                                                                                                          DateTime                     @default(now()) @updatedAt
  @@unique([projectId,id])
  @@index([projectId, state, publicId], map: "local_monitors_list")
  @@map("local_monitors")

  local_monitor_launch_intents                                                                                       LocalMonitorLaunchIntent[]
  local_monitor_occurrences                                                                                          LocalMonitorOccurrence[]
  local_monitor_retry_selections                                                                                     LocalMonitorRetrySelection[]
  local_monitor_revisions_local_monitor_revisions_projectId_monitorIdTolocal_monitors                                LocalMonitorRevision[]       @relation("local_monitor_revisions_projectId_monitorIdTolocal_monitors")
  local_monitor_schedule_intents_local_monitor_schedule_intents_projectId_monitorIdTolocal_monitors                  LocalMonitorScheduleIntent[] @relation("local_monitor_schedule_intents_projectId_monitorIdTolocal_monitors")
  local_monitor_revisions_local_monitors_projectId_id_currentRevisionIdTolocal_monitor_revisions                     LocalMonitorRevision?        @relation("local_monitors_projectId_id_currentRevisionIdTolocal_monitor_revisions", fields: [projectId, id, currentRevisionId], references: [projectId, monitorId, id], onDelete: NoAction, onUpdate: NoAction, map: "local_monitor_definition_head")
  local_monitor_schedule_intents_local_monitors_projectId_id_currentScheduleIntentIdTolocal_monitor_schedule_intents LocalMonitorScheduleIntent?  @relation("local_monitors_projectId_id_currentScheduleIntentIdTolocal_monitor_schedule_intents", fields: [projectId, id, currentScheduleIntentId], references: [projectId, monitorId, id], onDelete: NoAction, onUpdate: NoAction, map: "local_monitor_intent_head")
  projects                                                                                                           Project                      @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}
model LocalMonitorRevision {
  id String @id @default(cuid())
  projectId String
  monitorId String
  previousRevisionId String?
  revision Int
  entityId String
  identityRevisionId String
  gridRevisionKey String
  contentHash String
  snapshot Json
  actorId String?
  createdAt DateTime @default(now())
  @@unique([projectId,id])
  @@unique([projectId,monitorId,id])
  @@unique([monitorId,revision])
  @@map("local_monitor_revisions")

  local_monitor_grid_points                                                             LocalMonitorGridPoint[]
  local_monitor_keywords                                                                LocalMonitorKeyword[]
  local_monitor_occurrences                                                             LocalMonitorOccurrence[]
  local_monitor_recurring_approvals                                                     LocalMonitorRecurringApproval[]
  local_monitor_retry_selections                                                        LocalMonitorRetrySelection[]
  users                                                                                 User?                           @relation(fields: [actorId], references: [id], onUpdate: NoAction)
  business_identity_revisions                                                           BusinessIdentityRevision        @relation(fields: [projectId, entityId, identityRevisionId], references: [projectId, entityId, id], onDelete: NoAction, onUpdate: NoAction)
  projects                                                                              Project                         @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  local_monitors_local_monitor_revisions_projectId_monitorIdTolocal_monitors            LocalMonitor                    @relation("local_monitor_revisions_projectId_monitorIdTolocal_monitors", fields: [projectId, monitorId], references: [projectId, id], onDelete: Cascade, onUpdate: NoAction)
  local_monitor_revisions                                                               LocalMonitorRevision?           @relation("local_monitor_revisionsTolocal_monitor_revisions", fields: [projectId, monitorId, previousRevisionId], references: [projectId, monitorId, id], onDelete: NoAction, onUpdate: NoAction)
  other_local_monitor_revisions                                                         LocalMonitorRevision[]          @relation("local_monitor_revisionsTolocal_monitor_revisions")
  local_monitor_schedule_intents                                                        LocalMonitorScheduleIntent[]
  local_monitors_local_monitors_projectId_id_currentRevisionIdTolocal_monitor_revisions LocalMonitor[]                   @relation("local_monitors_projectId_id_currentRevisionIdTolocal_monitor_revisions")
}
model LocalMonitorGridPoint {
  projectId String
  revisionId String
  pointId String
  ordinal Int
  row Int
  column Int
  @@id([revisionId,ordinal])
  @@unique([revisionId,row,column])
  @@unique([revisionId,pointId])
  @@map("local_monitor_grid_points")

  projects                 Project               @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  local_measurement_points LocalMeasurementPoint @relation(fields: [projectId, pointId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  local_monitor_revisions  LocalMonitorRevision  @relation(fields: [projectId, revisionId], references: [projectId, id], onDelete: Cascade, onUpdate: NoAction)
}
model LocalMonitorKeyword {
  projectId String
  revisionId String
  keywordId String?
  keywordPublicId String
  ordinal Int
  sourceHash String
  @@id([revisionId,ordinal])
  @@unique([revisionId,keywordPublicId])
  @@map("local_monitor_keywords")

  projects                Project              @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  keywords                Keyword?             @relation(fields: [projectId, keywordId], references: [projectId, id], onDelete: SetNull, onUpdate: NoAction)
  local_monitor_revisions LocalMonitorRevision @relation(fields: [projectId, revisionId], references: [projectId, id], onDelete: Cascade, onUpdate: NoAction)
}
model LocalMonitorScheduleIntent {
  id String @id @default(cuid())
  projectId String
  monitorId String
  definitionRevisionId String
  previousRevisionId String?
  revision Int
  mode String
  scheduleId String?
  snapshot Json?
  approvalDigest String?
  capabilityVersion String?
  actorId String?
  createdAt DateTime @default(now())
  @@unique([projectId,monitorId,id])
  @@unique([monitorId,revision])
  @@map("local_monitor_schedule_intents")

  local_monitor_occurrences                                                                          LocalMonitorOccurrence[]
  local_monitor_recurring_approvals                                                                  LocalMonitorRecurringApproval[]
  local_monitor_retry_selections                                                                     LocalMonitorRetrySelection[]
  local_monitor_revisions                                                                            LocalMonitorRevision           @relation(fields: [projectId, monitorId, definitionRevisionId], references: [projectId, monitorId, id], onDelete: NoAction, onUpdate: NoAction, map: "local_monitor_schedule_intent_projectId_monitorId_definiti_fkey")
  local_monitor_schedule_intents                                                                     LocalMonitorScheduleIntent?    @relation("local_monitor_schedule_intentsTolocal_monitor_schedule_intents", fields: [projectId, monitorId, previousRevisionId], references: [projectId, monitorId, id], onDelete: NoAction, onUpdate: NoAction, map: "local_monitor_schedule_intent_projectId_monitorId_previous_fkey")
  other_local_monitor_schedule_intents                                                               LocalMonitorScheduleIntent[]   @relation("local_monitor_schedule_intentsTolocal_monitor_schedule_intents")
  users                                                                                              User?                          @relation(fields: [actorId], references: [id], onUpdate: NoAction)
  projects                                                                                           Project                        @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  local_monitors_local_monitor_schedule_intents_projectId_monitorIdTolocal_monitors                  LocalMonitor                   @relation("local_monitor_schedule_intents_projectId_monitorIdTolocal_monitors", fields: [projectId, monitorId], references: [projectId, id], onDelete: Cascade, onUpdate: NoAction)
  check_schedules                                                                                    CheckSchedule?                 @relation(fields: [projectId, scheduleId], references: [projectId, id], onDelete: SetNull, onUpdate: NoAction)
  local_monitors_local_monitors_projectId_id_currentScheduleIntentIdTolocal_monitor_schedule_intents LocalMonitor[]                  @relation("local_monitors_projectId_id_currentScheduleIntentIdTolocal_monitor_schedule_intents")
}
model LocalMonitorMutation {
  id String @id @default(cuid())
  projectId String
  operation String
  keyHash String
  bodyHash String
  actorId String?
  result Json
  createdAt DateTime @default(now())
  @@unique([projectId,operation,keyHash])
  @@map("local_monitor_mutations")

  users     User?    @relation(fields: [actorId], references: [id], onUpdate: NoAction)
  projects  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}
