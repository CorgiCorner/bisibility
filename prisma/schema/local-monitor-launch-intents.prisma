model LocalMonitorLaunchIntent {
 id String @id
 publicId String @unique
 projectId String
 monitorId String
 actorId String?
 command Json
 bodyHash String
 keyHash String
 connectionStamp String
 consentDigest String
 approvedAt DateTime
 expiresAt DateTime
 collectionDeadline DateTime
 pollIntervalMs Int
 runId String?
 origin String @default("manual")
 recurringApprovalId String?
 recurringOccurrenceKey String?
 state String @default("queued")
 reason String?
 leaseToken String?
 leaseVersion Int @default(0)
 leaseExpiresAt DateTime?
 version Int @default(0)
 createdAt DateTime @default(now())
  updatedAt                         DateTime                       @default(now()) @updatedAt
 @@unique([projectId,keyHash])
 @@index([state,leaseExpiresAt,createdAt],map:"local_monitor_launch_intents_pending")
 @@index([projectId,monitorId,createdAt,id],map:"local_monitor_launch_intents_history")
 @@map("local_monitor_launch_intents")

  @@unique([projectId, id], map: "local_monitor_launch_project_id")
  users                             User?                          @relation(fields: [actorId], references: [id], onUpdate: NoAction)
  projects                          Project                        @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  local_monitors                    LocalMonitor                   @relation(fields: [projectId, monitorId], references: [projectId, id], onDelete: Cascade, onUpdate: NoAction)
  local_measurement_runs            LocalMeasurementRun?           @relation(fields: [projectId, runId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  local_monitor_recurring_approvals LocalMonitorRecurringApproval? @relation(fields: [projectId, recurringApprovalId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction, map: "local_monitor_launch_recurring_approval")
  local_monitor_retry_selections    LocalMonitorRetrySelection[]
}
