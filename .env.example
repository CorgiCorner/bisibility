# bisibility .env.example for self-hosted installs.
# Copy to .env, then generate the two blank secrets before starting Docker:
#   openssl rand -base64 32

## Required

# PostgreSQL connection used by the app. Docker Compose provides this database.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://bisibility:${POSTGRES_PASSWORD}@postgres:5432/bisibility?schema=public

# Direct PostgreSQL connection used by Prisma migrations. In local Docker this
# can match DATABASE_URL; managed deployments should use the direct endpoint.
DIRECT_URL=postgresql://bisibility:${POSTGRES_PASSWORD}@postgres:5432/bisibility?schema=public

# Per-process PostgreSQL pool settings. Total database usage is the pool maximum
# multiplied by the number of running app or worker processes.
DATABASE_POOL_MAX=3
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=10000
DATABASE_APPLICATION_NAME=bisibility-ssr

# Redis or Valkey URL for rate limiting, idempotency, and realtime fan-out.
REDIS_URL=redis://redis:6379

# Public app URL. Required for correct canonical URLs, sitemap entries,
# robots.txt sitemap links, generated social images, OAuth redirects, and auth
# callbacks. Use the final public origin for the deployment.
SITE_URL=http://localhost:3000
# Public documentation origin compiled into navigation and footer links.
# Override with the direct Mintlify origin while validating a custom-domain cutover.
NEXT_PUBLIC_DOCS_URL=https://bisibility.com/docs
# Optional privacy-first site analytics. Set both values to load the tracker;
# the Stats API token is server-side only and must never be exposed here.
# NEXT_PUBLIC_PLAUSIBLE_URL=https://analytics.example.com
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=example.com
# When SITE_URL is unset, production honors the request origin only with this
# opt-in. Enable only behind a trusted proxy that strips client-supplied
# forwarded-host headers (e.g. preview deployments).
# TRUST_REQUEST_ORIGIN=false
BETTER_AUTH_URL=http://localhost:3000

# Deployment stage and mode. Local self-hosting is the public default.
DEPLOYMENT_ENV=development
DEPLOYMENT_MODE=self-host

# Required production secrets. Generate unique values with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
BISIBILITY_SECRETS_KEY=
# Optional comma-separated prior keys used only to decrypt and rotate existing
# provider, webhook, and Slack secrets after changing the primary key.
# BISIBILITY_SECRETS_KEYS_RETIRED=

## Instance migration

# Destination instance URL used by migration handoff and transfer actions.
# BISIBILITY_CLOUD_URL=https://cloud.example.com
# Migration token lifetime in minutes. Defaults to 60 and is clamped to 5..1440.
# BISIBILITY_MIGRATION_TOKEN_TTL_MINUTES=60
# Migration hold auto-release TTL in hours. Defaults to 24.
# BISIBILITY_MIGRATION_HOLD_TTL_HOURS=24
# Maximum inbound migration import payload size in bytes. Defaults to 8 MiB.
# BISIBILITY_MIGRATION_IMPORT_MAX_BODY_BYTES=8388608
# Maximum keywords in a downloadable migration package. Defaults to 500.
# BISIBILITY_MIGRATION_EXPORT_MAX_KEYWORDS=500
# Maximum keywords allowed for chunked direct migration push. Defaults to 50000.
# BISIBILITY_MIGRATION_MAX_KEYWORDS=50000
# Comma-separated hostnames allowed as migration targets. Supports *.suffix
# wildcards. Empty allows any public host.
# BISIBILITY_MIGRATION_TARGET_ALLOWLIST=cloud.example.com,*.example.com

## First-run auth

# Throwaway local demo only. When set to 1, anyone can sign in with code 000000.
# Docker's db-migrations service also seeds demo@acme.dev so the dashboard opens with data.
# DEMO_FIXED_OTP=
# Required acknowledgement when DEMO_FIXED_OTP=1 runs in a production Docker image.
# Never set this on an instance with real users or data.
# DEMO_INSTANCE_INSECURE_AUTH_ACK=

# Production sign-in email delivery. Required when DEMO_FIXED_OTP is off and
# email OTP sign-in is used. Setup guide: https://bisibility.com/docs/guides/email
# Delivery provider: "resend", "ses", or "smtp". Required to send any email; without it,
# development logs messages to the console and production refuses to send.
# EMAIL_PROVIDER=resend
# Sender for all transactional email. Must be verified with the selected provider.
# EMAIL_FROM="bisibility <no-reply@example.com>"
# Optional dedicated sender for ranking alerts; falls back to EMAIL_FROM.
# EMAIL_ALERTS_FROM="bisibility alerts <alerts@example.com>"
# Resend (EMAIL_PROVIDER=resend)
# RESEND_API_KEY=
# Amazon SES (EMAIL_PROVIDER=ses). Credentials come from the standard AWS SDK
# chain; SES_REGION falls back to AWS_REGION/AWS_DEFAULT_REGION when unset.
# SES_REGION=eu-central-1
# SES_CONFIGURATION_SET=
# SMTP relay (EMAIL_PROVIDER=smtp). Supports smtp:// and smtps:// connection URLs.
# SMTP_URL=smtp://user:pass@mail.example.com:587
# WAITLIST_NOTIFY_EMAIL=

## Public logo images

# Optional logo.dev token for provider and competitor logo images.
# NEXT_PUBLIC_LOGODEV_TOKEN=

# Optional Sentry error monitoring. Set both DSN values for browser and server
# errors. SENTRY_AUTH_TOKEN and SENTRY_ORG are build-time only and upload source
# maps to the configured Sentry project slug (`bisibility` by default).
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_ENVIRONMENT=production
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=
# NEXT_PUBLIC_SENTRY_RELEASE=
# SENTRY_TRACES_SAMPLE_RATE=0.05
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.05

# Optional data-residency label shown in auth/onboarding surfaces.
# DATA_REGION=

## OAuth integrations

# GitHub social sign-in.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Google social sign-in and Google Search Console / GA4 account connections.
# Enable the Search Console API, Analytics Data API, and Analytics Admin API,
# add the scopes below (plus openid + email) to the OAuth consent screen, and
# list <SITE_URL>/api/integrations/google/callback as an authorized redirect
# URI on a Web application OAuth client. Full guide: docs/integrations.mdx.
#   GSC: https://www.googleapis.com/auth/webmasters  (full scope - sitemap
#        re-submission is a write call, so webmasters.readonly is not enough)
#   GA4: https://www.googleapis.com/auth/analytics.readonly
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Slack alert channel installation.
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=

## Rank provider credentials

# Optional env fallback credentials. Project-level encrypted credentials from the
# UI take precedence.
# DATAFORSEO_LOGIN=
# DATAFORSEO_PASSWORD=
# SERPAPI_API_KEY=

## Temporal scheduling

# Default Docker starts manual rank checks only. Use
# `docker compose --profile scheduled up --build` to start Temporal + worker.
# TEMPORAL_ADDRESS=
# TEMPORAL_API_KEY=
# TEMPORAL_NAMESPACE=default
# TEMPORAL_TASK_QUEUE=rank-checks
# TEMPORAL_MAX_CONCURRENT_ACTIVITIES=5
# BISIBILITY_WORKER_DATABASE_POOL_MAX=4
# TEMPORAL_TLS=

# Exclusive automatic scheduler ownership: legacy, cutover, or dispatcher.
# D1 defaults to legacy. Invalid non-empty values fail closed.
RANK_CHECK_SCHEDULER_MODE=legacy
# Deprecated D1-only fallback when the exclusive mode is absent.
# RANK_CHECK_RECONCILER_ENABLED=
# RANK_CHECK_DISPATCHER_ENABLED=
# Rank-check and worker schedule tuning. The monthly provider budget is a
# per-workspace setting edited in Settings > Provider usage, not an env var.
# RANK_CHECK_RECONCILER_INTERVAL=2 minutes
# RANK_CHECK_DISPATCHER_INTERVAL=1 minute
# Queued provider batches remain independently OFF unless explicitly enabled,
# and paid submission is authorized only in dispatcher mode.
# DATAFORSEO_QUEUED_RANK_CHECKS_ENABLED=
# DATAFORSEO_QUEUE_PRIORITY=high
# DATAFORSEO_QUEUE_POLL_INTERVAL_SECONDS=
# DATAFORSEO_QUEUE_MAX_AGE_SECONDS=
# SCHEDULED_MAINTENANCE_ENABLED=
# STALE_CHECKS_INTERVAL=10 minutes
# AUDIT_PURGE_CRON=
# QUEUED_RANK_CHECK_RETENTION_CRON=
# SESSION_PURGE_CRON=
# WEEKLY_DIGEST_CRON=
# SITEMAP_SYNC_ENABLED=
# SITEMAP_SYNC_CRON=
# PRESENCE_SYNC_ENABLED=
# PRESENCE_SYNC_CRON=
# Worker-owned daily analytics traffic import. The worker process must be running because
# its Temporal schedule is the only scheduled traffic-sync path.
# TRAFFIC_SYNC_ENABLED=
# Override the default 05:45 UTC schedule with a cron expression.
# TRAFFIC_SYNC_CRON=
# Retain traffic snapshots for this many days. Defaults to 180.
# TRAFFIC_SNAPSHOT_RETENTION_DAYS=180

## Rate limits and Redis TLS

# Base64-encoded PEM CA for rediss:// endpoints using a private CA.
# REDIS_TLS_CA_B64=

# HTTP API limits. Defaults are 600/min per API key and 60/min anonymous.
# BISIBILITY_API_KEY_RATE_LIMIT_PER_MINUTE=
# BISIBILITY_API_ANON_RATE_LIMIT_PER_MINUTE=

# Set only when you trust your reverse proxy/CDN x-forwarded-for chain.
# BISIBILITY_TRUST_CDN_X_FORWARDED_FOR=
# BISIBILITY_CDN_TRUSTED_HOPS=1

# Per-provider outbound limits. Defaults are DataForSEO 1800/min, GSC 600/min,
# SerpAPI 60/min, and GA4 60/min. Set _DISABLED=1 only for local testing.
# BISIBILITY_PROVIDER_RATE_LIMIT_DISABLED=
# BISIBILITY_PROVIDER_RATE_LIMIT_DATAFORSEO_PER_MINUTE=1800
# BISIBILITY_PROVIDER_RATE_LIMIT_DATAFORSEO_WINDOW_SECONDS=60
# BISIBILITY_PROVIDER_RATE_LIMIT_GSC_PER_MINUTE=600
# BISIBILITY_PROVIDER_RATE_LIMIT_GSC_WINDOW_SECONDS=60
# BISIBILITY_PROVIDER_RATE_LIMIT_SERPAPI_PER_MINUTE=60
# BISIBILITY_PROVIDER_RATE_LIMIT_SERPAPI_WINDOW_SECONDS=60
# BISIBILITY_PROVIDER_RATE_LIMIT_GA4_PER_MINUTE=60
# BISIBILITY_PROVIDER_RATE_LIMIT_GA4_WINDOW_SECONDS=60

## Maintenance and audit

# AUDIT_RETENTION_DAYS=365

# Optional HMAC secret for hashing source IPs in audit records.
# AUDIT_IP_HMAC_SECRET=

# Optional release/version label stored with audit records.
# APP_VERSION=

## Webhooks

# SECURITY: Allows outbound webhook delivery to private, LAN, and loopback
# targets. Leave unset unless this self-hosted instance must deliver to trusted
# internal services.
# WEBHOOK_ALLOW_PRIVATE_NETWORK=

# ── Operator observability (optional, off by default) ──
# Instance-level Slack incoming webhook. This is separate from tenant Slack OAuth alerts.
# OPS_SLACK_WEBHOOK_URL=
# Defaults to enabled when OPS_SLACK_WEBHOOK_URL is set. Set to 0 to disable explicitly.
# OPS_EVENTS_ENABLED=
# failures posts failures, warnings, startup, and the daily digest; all adds successes.
# OPS_NOTIFY_MODE=failures
# Daily heartbeat cron and IANA timezone.
# OPS_HEARTBEAT_CRON=0 8 * * *
# OPS_HEARTBEAT_TZ=Etc/UTC
# Duplicate event suppression window in minutes.
# OPS_THROTTLE_MINUTES=60
# Base URL of your Temporal Web UI. When set, ops Slack messages link workflows to it.
# TEMPORAL_UI_URL=

## Caching / performance tuning

# Redis TTL (seconds) for cached keyword-research results. Defaults to 43200 (12h).
# KEYWORD_RESEARCH_CACHE_TTL_SECONDS=43200
# Redis TTL (seconds) for cached ranked-keyword results. Defaults to 43200 (12h).
# RANKED_KEYWORDS_CACHE_TTL_SECONDS=43200
