# Generated from scripts/release/public-env-registry.mjs. Do not edit by hand.
# Production setup: node generate-self-host-env.mjs --site-url https://rank.example.com
# Complete variable reference: https://bisibility.com/docs/self-hosting#optional-environment-variables

## Required and production defaults

POSTGRES_PASSWORD=
DATABASE_URL=postgresql://bisibility:${POSTGRES_PASSWORD}@postgres:5432/bisibility?schema=public
DIRECT_URL=postgresql://bisibility:${POSTGRES_PASSWORD}@postgres:5432/bisibility?schema=public
DATABASE_POOL_MAX=3
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=10000
DATABASE_APPLICATION_NAME=bisibility-ssr
REDIS_URL=redis://redis:6379
SITE_URL=
SELF_HOSTED_ALLOW_INDEXING=false
NEXT_PUBLIC_DOCS_URL=https://bisibility.com/docs
BETTER_AUTH_URL=
DEPLOYMENT_ENV=production
DEPLOYMENT_MODE=self-host
BETTER_AUTH_SECRET=
BISIBILITY_SECRETS_KEY=
RANK_CHECK_SCHEDULER_MODE=legacy

