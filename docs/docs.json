            ]
          },
          {
            "group": "Sitemap Monitoring",
            "pages": [
              "GET /projects/{project_id}/sitemap-monitors",
              "PATCH /projects/{project_id}/sitemap-monitors/{monitor_id}"
            ]
          },
          {
            "group": "Saved Keywords",
            "pages": [
              "GET /projects/{project_id}/saved-keywords",
              "POST /projects/{project_id}/saved-keywords",
              "DELETE /projects/{project_id}/saved-keywords/{saved_keyword_id}"
            ]
          },
          {
            "group": "Saved Views",
            "pages": [
              "GET /projects/{project_id}/saved-views",
              "POST /projects/{project_id}/saved-views",
              "DELETE /projects/{project_id}/saved-views/{view_id}",
              "DELETE /saved-views/{view_id}"
            ]
          },
          {
            "group": "Signals",
            "pages": ["GET /projects/{project_id}/signals", "POST /signals"]
          },
          {
            "group": "Providers",
            "pages": [
              "GET /projects/{project_id}/providers",
              "POST /projects/{project_id}/providers/{provider_id}/connect",
              "POST /projects/{project_id}/providers/{provider_id}/test",
              "PATCH /projects/{project_id}/providers/{provider_id}",
              "DELETE /projects/{project_id}/providers/{provider_id}"
            ]
          },
          {
            "group": "Webhooks",
            "pages": [
              "GET /projects/{project_id}/webhooks",
              "POST /projects/{project_id}/webhooks",
              "PATCH /projects/{project_id}/webhooks/{webhook_id}",
              "DELETE /projects/{project_id}/webhooks/{webhook_id}"
            ]
          },
          {
            "group": "Team",
            "pages": [
              "GET /projects/{project_id}/team/members",
              "PATCH /projects/{project_id}/team/members/{member_id}",
              "DELETE /projects/{project_id}/team/members/{member_id}",
