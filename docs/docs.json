  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/CorgiCorner/bisibility"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open bisibility",
      "href": "https://bisibility.com"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/CorgiCorner/bisibility"
    }
  },
  "redirects": [
    {
      "source": "/api/resources",
      "destination": "/api/overview"
    }
  ],
  "seo": {
    "indexing": "all",
    "metatags": {
      "canonical": "https://bisibility.com/docs"
    }
  }
