          {
            "group": "Migration",
            "pages": [
              "GET /projects/{project_id}/migration-tokens",
              "POST /projects/{project_id}/migration-tokens",
              "DELETE /projects/{project_id}/migration-tokens/{token_id}",
              "DELETE /migration-tokens/{token_id}",
              "POST /cloud/import",
              "GET /cloud/import/compatibility",
              "POST /cloud/import/sessions",
              "PUT /cloud/import/sessions/{sessionId}/chunks/{index}",
              "POST /cloud/import/sessions/{sessionId}/finalize"
